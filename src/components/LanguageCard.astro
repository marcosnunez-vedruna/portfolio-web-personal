---
import { getCardColorStyles } from '../utils/colours.js';

interface Props {
  language: string;
  level: string;
  flag: string;
  color: string; // yellow, red, green, blue
}

const { language, level, flag, color } = Astro.props;
const cardStyles = getCardColorStyles(color);
---

<div class="card" style={cardStyles}>
  <img src={flag} alt={`Bandera de ${language}`} class="flag" />
  <div class="content">
    <span class="level">{level}</span>
    <h3 class="language-name">{language}</h3>
  </div>
</div>

<style>

    .card {
        background-color: #383B42;
        border: 1px solid var(--card-color);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        width: 100%;
        box-sizing: border-box;
    }

    .flag {
        width: 60px;
        height: 40px;
        object-fit: cover;
        border-radius: 6px;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .level {
        color: var(--card-color);
        font-size: 0.9rem;
        font-weight: 500;
    }

    .language-name {
        font-size: 1.35rem;
        font-weight: 800;
        margin: 0;
        line-height: 1.1;
    }
</style>