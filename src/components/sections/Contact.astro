---
import SectionTitle from '../common/SectionTitle.astro';
import ContactCard from '../cards/ContactCard.astro';

---

<section id="contact" class="contact">
    <SectionTitle number = "06" title="Contacto"/>

    <h1>Trabajemos juntos</h1>

    <ContactCard />
</section>

<style>

    .contact {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 5rem;
    }

    h1 {
        font-family: var(--font-montserrat);
        font-size: 3.3rem;
        font-style: italic;
        font-weight: 100;
    }

</style>
