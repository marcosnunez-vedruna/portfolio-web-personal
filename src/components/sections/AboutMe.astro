---
import SectionTitle from "../common/SectionTitle.astro";

---

<section id="about-me" class="about-me">
    <SectionTitle number = "01" title="Sobre mí"/>

    <div class="content">
        <div class="text">
            <h2 class="full-name">
                <span class="surname">Núñez Curiel</span>
                <span class="firstname">Marcos</span>
            </h2>
            <p class="description">Soy una persona proactiva, organizada y responsable, con buenas relaciones interpersonales. Siempre tengo la mejor disposición para la realización de mi trabajo.</p>
            <div class="buttons">
                <a
                    href="#contact"
                    class="contact-button"
                >
                    Contáctame
                </a>
                <a
                    href="public/cv/mi-cv.pdf"
                    download="Marcos_Núñez_Curiel_CV.pdf"
                    class="cv-button"
                >
                    Mi curriculum
                    <img src="src/assets/icono-descargar.png" alt="icono-descargar" />
                </a>
            </div>
        </div>
        <div class="image-container">
            <img src="src/assets/mi-foto.png" alt="mi-foto" />
        </div>
    </div>
</section>

<style>

    .content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .full-name {
        display: flex;
        flex-direction: column;
        margin-bottom: 1.5rem;
        font-family: var(--font-montserrat);
        text-transform: uppercase;
    }

    .surname {
        font-size: 3.8rem;
        font-style: italic;
    }

    .firstname {
        font-size: 4.8rem;
    }

    .description {
        max-width: 460px;
        margin-bottom: 2.5rem;
        font-family: var(--font-inter);
        font-size: 1rem;
    }

    .buttons {
        display: flex;
        gap: 2rem;
    }

    .buttons a {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: var(--normal-bg);
        border: 1px solid transparent;
        border-radius: 50px;
        padding: 0.75rem 1rem;
        font-family: var(--font-inter);
        font-size: 0.9rem;
        font-weight: 700;
        transition: all 0.25s ease-in-out;
    }

    .contact-button {
        background-color: var(--color-blue);
    }

    .contact-button:hover {
        background-color: var(--normal-bg);
        color: var(--color-blue) !important;
        border: 1px solid var(--color-blue) !important;
        box-shadow: 0 0 15px var(--white-text);
    }

    .cv-button {
        background-color: var(--color-red);
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .cv-button:hover {
        background-color: var(--normal-bg);
        color: var(--color-red) !important;
        border: 1px solid var(--color-red) !important;
        box-shadow: 0 0 15px var(--white-text);
    }

    .cv-button img {
        height: 20px;
    }

    .image-container {
        width: 320px;
        height: 380px;
        border-radius: 50%;
        overflow: hidden;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

</style>

<script>

    document.addEventListener("DOMContentLoaded", () => {
        const contactButton = document.querySelector(".contact-button");

        contactButton?.addEventListener("click", (e) => {
            e.preventDefault();
            
            const targetId = contactButton.getAttribute("href");
            if (!targetId) return;

            const targetSection = document.querySelector(targetId);

            if (targetSection) {
                targetSection.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        });
    });

</script>
