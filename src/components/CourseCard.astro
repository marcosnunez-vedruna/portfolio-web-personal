---
import { getCardColorStyles } from '../utils/colours.js';

interface Props {
  title: string;
  platform: string;
  year: string;
  certificateURL: string;
  color: string; // 'yellow', 'red', 'green', 'blue'
}

const { title, platform, year, certificateURL, color } = Astro.props;
const cardStyles = getCardColorStyles(color);
---

<a href={certificateURL} target="_blank" class="card" style={cardStyles}`}>
  <div class="card-left">
    <span class="diamond">◆</span>
    <div class="info">
      <h4 class="title">{title}</h4>
      <p class="subtitle">{platform} · {year}</p>
    </div>
  </div>

  <span class="arrow-icon">↗</span>
</a>

<style>

    .card {
        background-color: #383B42;
        border: 1px solid var(--card-color);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
        box-sizing: border-box;
        text-decoration: none;
        color: inherit;
        width: 100%;
    }

    .card:hover {
        background-color: var(--bg-grey-color);
        border: 1px solid #18191C;
    }

    .card-left {
        display: flex;
        align-items: start;
        gap: 1rem;
    }

    .diamond {
        color: var(--card-color);
        font-size: 1rem;
    }

    .card:hover .diamond {
        color: #383B42;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .title {
        margin: 0;
    }

    .subtitle {
        color: #9CA3AF;
        margin: 0;
    }

    .card:hover .title, .card:hover .subtitle {
        color: #383B42;
    }

    .arrow-icon {
        position: relative;
        top: -10px;
        color: #383B42;
        font-size: 1.4rem;
        font-weight: 700;
        opacity: 0;
        transform: translate(-4px, 4px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .card:hover .arrow-icon {
        opacity: 1;
    }
    
</style>