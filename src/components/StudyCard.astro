---
interface Props {
  title: string;
  date: string;
  institution: string;
  location: string;
  color: string; // yellow, red, green, blue
}

const { title, date, institution, location, color } = Astro.props;
---

<div class={`card ${color}`}>
    <div class="top-content">
        <span class="date">{date}</span>
        <h3 class="title">{title}</h3>
    </div>
    <div class="footer-info">
        <p class="institution">{institution}</p>
        <p class="location">📍 {location}</p>
    </div>
</div>

<style>
    .yellow { --card-color: #F6E05E; }
    .red    { --card-color: #FEB2B2; }
    .green  { --card-color: #9AE6B4; }
    .blue   { --card-color: #90CDF4; }

    .card {
        background-color: #383B42;
        border: 1px solid var(--card-color);
        border-radius: 12px;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
        width: 100%;
        box-sizing: border-box;
        padding: 2.5rem 2rem;
    }

    .top-content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .date {
        color: var(--card-color);
        font-weight: 700;
        font-size: 1.05rem;
    }

    .title {
        font-weight: 800;
        font-size: 1.45rem;
        line-height: 1.25;
        margin: 0;
        white-space: pre-line;
    }

    .footer-info {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        color: #9CA3AF;
        font-size: 0.95rem;
    }

    .institution, .location {
        margin: 0;
        line-height: 1.4;
    }

</style>