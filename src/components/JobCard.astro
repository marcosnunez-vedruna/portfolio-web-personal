---
interface Props {
  role: string;
  company: string;
  date: string;
  description: string;
  color: string; // yellow, red, green, blue
}

const { role, company, date, description, color } = Astro.props;
---

<article class="card" style={`--card-color: var(--color-${color});`}>
  <div class="timeline-indicator">
    <span class="dot"></span>
    <div class="line"></div>
  </div>

  <div class="content">
    <header class="header">
      <div class="titles">
        <h3 class="role">{role}</h3>
        <p class="company">{company}</p>
      </div>
      <span class="date">{date}</span>
    </header>

    <p class="description">{description}</p>
  </div>
</article>

<style>

    .card {
        display: flex;
        gap: 1.5rem;
        position: relative;
        padding-bottom: 2.5rem;
        width: 100%;
    }

    .timeline-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 12px;
    }

    .dot {
        width: 10px;
        height: 10px;
        background-color: var(--card-color);
        border-radius: 50%;
        margin-top: 0.35rem;
        z-index: 1;
    }

    .line {
        width: 2px;
        flex-grow: 1;
        margin-top: 0.4rem;
        background: linear-gradient(
            to bottom,
            var(--white-text); 0%,
            var(--grey-text); 40%,
            var(--normal-bg); 100%
        );
    }

    .content {
        flex-grow: 1;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .role {
        margin: 0;
    }

    .company {
        margin: 0.2rem 0 0 0;
        color: var(--card-color);
        font-style: italic;
        font-weight: 600;
    }

    .date {
        color: var(--grey-text);;
        white-space: nowrap;
    }

    .description {
        margin: 0.75rem 0 0 0;
        line-height: 1.6;
        width: 60%;
    }
</style>