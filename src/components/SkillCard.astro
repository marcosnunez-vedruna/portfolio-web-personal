---
import { getCardColorStyles } from '../utils/colours.js';

interface Props {
  name: string;
  icon: string;
  color: string; // yellow, red, green, blue
}

const { name, icon, color } = Astro.props;
const cardStyles = getCardColorStyles(color);
---

<div class="card" style={cardStyles}>
    <div class="icon-wrapper">
        <img src={icon} alt={name} class="icon" />
    </div>
    <span class="name">{name}</span>
</div>

<style>

    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100px;
        position: relative;   
    }

    .icon-wrapper {
        width: 95px;
        height: 95px;
        border-radius: 50%;
        border: 2px solid var(--card-color);
        background-color: #383B42;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
        box-sizing: border-box;
        transition: transform 0.3s ease, box-shadow 0.25s ease;
    }

    .card:hover .icon-wrapper {
        box-shadow: 0 0 12px #EAECEF;
    }

    .icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0.8;
        transition: opacity 0.25s ease;
    }

    .card:hover .icon {
        opacity: 1;
    }

    .name {
        text-align: center;
        font-size: 0.82rem;
        font-weight: 600;
        border: 1px solid var(--card-color);
        border-radius: 50px;
        padding: 0.25rem 0.75rem;
        background-color: #383B42;
        white-space: nowrap;
        margin-top: -14px;
        z-index: 2;
        transition: box-shadow 0.25s ease;
    }

    .card:hover .name {
        box-shadow: 0 0 12px #EAECEF;
    }

</style>