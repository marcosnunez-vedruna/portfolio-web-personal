---
import SectionTitle from '../components/SectionTitle.astro';
import Separator from '../components/Separator.astro';

import StudyCard from '../components/StudyCard.astro';
import LanguageCard from '../components/LanguageCard.astro';
import SkillCard from '../components/SkillCard.astro';
import CourseCard from '../components/CourseCard.astro';

import studiesData from '../data/studies.json';
import languagesData from '../data/languages.json';
import skillsData from '../data/skills.json';
import coursesData from '../data/courses.json';
---

<section id="education" class="education">
    <SectionTitle number="02" title="Educación" />

    <div class="subsection studies">
        {studiesData.map((study) => (
            <div class="card">
                <StudyCard
                    title={study.title}
                    date={study.date}
                    institution={study.institution}
                    location={study.location}
                    color={study.color}
                />
            </div>
        ))}
    </div>

    <Separator variant='short' />

    <h2>Idiomas</h2>
    <div class="subsection languages">
        {languagesData.map((lang) => (
            <div class="card">
                <LanguageCard
                    language={lang.language}
                    level={lang.level}
                    flag={lang.flag}
                    color={lang.color}
                />
            </div>
        ))}
    </div>

    <Separator variant='short' />

    <h2>Skills</h2>
    <div class="skills-container">
        {skillsData.map((group) => (
            <div class="skill-category">
                <h4>{group.category}</h4>
                <div class="skills-list">
                    {group.skills.map((skill) => (
                        <SkillCard
                            name={skill.name}
                            icon={skill.icon}
                            color={skill.color}
                        />
                    ))}
                </div>
            </div>
        ))}
    </div>

    <Separator variant='short' />

    <h2>Cursos</h2>
    <div class="subsection courses">
        {coursesData.map((course) => (
            <div class="card">
                <CourseCard
                    title={course.title}
                    platform={course.platform}
                    year={course.year}
                    certificateURL={course.certificateUrl}
                    color={course.color}
                />
            </div>
        ))}
    </div>
    
</section>

<style>
    .education {
        width: 100%;
        max-width: 80%;
        margin: 0 auto;
        padding: 1rem 0;
        display: flex;
        flex-direction: column;
    }

    h2 {
        align-self: center;
    }

    .subsection {
        display: grid;
        gap: 2rem;
        width: 100%;
    }
    
    .card {
        display: flex;
    }

    .studies {
        grid-template-columns: repeat(2, 1fr);
    }

    .languages, .courses {
        grid-template-columns: repeat(3, 1fr);
    }

    .skills-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
    }

    .skill-category {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .skills-list {
        display: grid;
        gap: 1.5rem;
        width: 100%;
        grid-template-columns: repeat(5, 1fr);
    }



.course-card > * {
  width: 100%;
}

@media (max-width: 900px) {
  .courses {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
}

</style>