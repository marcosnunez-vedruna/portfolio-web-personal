---
interface Props {
    title: string;
    platform: string;
    year: string;
    certificateURL: string;
    color: string; // 'yellow', 'red', 'green', 'blue'
}

const { title, platform, year, certificateURL, color } = Astro.props;
---

<a
    href={certificateURL}
    target="_blank"
    class="card"
    style={`--card-color: var(--color-${color}); --bg-grey-color: var(--color-${color}-bg);`}
>
    <div class="content">
        <div class="diamond">◆</div>
        <div class="info">
            <p class="title">{title}</p>
            <p class="subtitle">{platform} · {year}</p>
        </div>
    </div>
    <span class="arrow">↗</span>
</a>

<style>

    .card {
        text-decoration: none;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        background-color: var(--light-bg);
        color: var(--white-text);
        border: 1px solid var(--card-color);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        font-family: var(--font-inter);
        transition: all 0.3s ease;
    }

    .content {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .diamond {
        color: var(--card-color);
        font-size: 1.25rem;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .title {
        margin: 0;
        font-size: 1.25rem;
    }

    .subtitle {
        margin: 0;
        color: var(--grey-text);
        font-size: 0.9rem;
    }

    .arrow {
        position: relative;
        top: -5px;
        color: var(--light-bg);
        font-size: 1.5rem;
        font-weight: 700;
        transition: all 0.25s ease-in-out;
    }

    /* Hover */
    .card:hover {
        background-color: var(--bg-grey-color);
        border: 1px solid var(--dark-bg);
    }

    .card:hover .diamond, .card:hover .title, .card:hover .subtitle {
        color: var(--light-bg);
    }

</style>