---
interface Props {
  language: string;
  level: string;
  flag: string;
  color: string; // yellow, red, green, blue
}

const { language, level, flag, color } = Astro.props;
---

<div class="card" style={`--card-color: var(--color-${color});`}>
    <img src={flag} alt={`Bandera de ${language}`} class="flag" />
    <div class="content">
        <span class="level">{level}</span>
        <h3 class="name">{language}</h3>
    </div>
</div>

<style>

    .card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.5rem 2rem;
        background-color: var(--light-bg);
        border: 1px solid var(--card-color);
        border-radius: 12px;
    }

    .flag {
        width: 65px;
        height: 45px;
        object-fit: cover;
        border-radius: 6px;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-family: var(--font-inter);
    }

    .level {
        margin: 0;
        color: var(--card-color);
        font-size: 0.9rem;
        font-weight: 500;
    }

    .name {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
    }

</style>
