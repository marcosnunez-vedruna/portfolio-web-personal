---
import { getRootColourVariables } from '../utils/colours.js';
import { getRootFontVariables } from '../utils/fonts.js';
const rootVars = {
	...getRootColourVariables(),
	...getRootFontVariables()
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/src/assets/logo-mnc.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>MNC - Portfolio</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global define:vars={rootVars}>
	@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

	body {
		background-color: var(--normal-bg);
		color: var(--white-text);
		margin: 0;
  	}

	section {
		margin: 0 10%;
        padding: 1rem 0;
	}
	
</style>
