---
import { getRootColourVariables } from '../utils/colours.js';
import { getRootFontVariables } from '../utils/fonts.js';
const rootVars = {
  ...getRootColourVariables(),
  ...getRootFontVariables()
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>MNC - Portfolio</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global define:vars={rootVars}>
	body {
		background-color: var(--normal-bg);
		color: var(--white-text);
		margin: 0;
  	}
</style>
